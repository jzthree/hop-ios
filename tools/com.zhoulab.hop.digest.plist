<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zhoulab.hop.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>node "$HOME/Code/hop-ios/tools/digest.mjs" &gt;&gt; /tmp/hop-digest.log 2&gt;&amp;1</string>
  </array>
  <!-- Hourly at :40 (Jian). Affordable because the generator suppresses:
       a quiet hour is a hash comparison and no model call, and an hour whose
       changes the agent judges non-newsworthy keeps the current edition.
       :40 keeps the pre-wake edition landing before ~7:00. -->
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>40</integer></dict>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
